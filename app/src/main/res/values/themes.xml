<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NightRider" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/cyan</item>
        <item name="android:colorPrimaryDark">@color/void_night</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:textColorPrimary">@color/ice</item>
        <item name="android:textColorSecondary">@color/mist</item>
        <item name="android:windowBackground">@drawable/bg_nightwave</item>
        <item name="android:statusBarColor">@color/void_night</item>
        <item name="android:navigationBarColor">@color/void_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- The page is already dark; stop Android from darkening it twice. -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="nrAccent">@color/cyan</item>
        <item name="nrSecondary">@color/plum</item>
        <item name="nrText">@color/ice</item>
        <item name="nrMuted">@color/mist</item>
        <item name="nrDanger">@color/rose</item>
        <item name="nrTopbar">@color/void_night</item>
        <item name="nrPrimaryButtonText">@color/cyan</item>
        <item name="nrSecondaryButtonText">@color/plum</item>
        <item name="nrPanelBackground">@drawable/panel</item>
        <item name="nrPrimaryButton">@drawable/btn_outline</item>
        <item name="nrSecondaryButton">@drawable/btn_outline_plum</item>
    </style>

    <style name="Theme.NightRider.Aero" parent="Theme.NightRider">
        <!-- Rounded humanist lettering to match the web LIGHT Nunito Sans style. -->
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="android:colorPrimary">@color/aero_blue</item>
        <item name="android:colorPrimaryDark">@color/aero_status</item>
        <item name="android:colorAccent">@color/aero_blue</item>
        <item name="android:textColorPrimary">@color/aero_ink</item>
        <item name="android:textColorSecondary">@color/aero_muted</item>
        <item name="android:windowBackground">@drawable/bg_aero_sky</item>
        <item name="android:statusBarColor">@color/aero_status</item>
        <item name="android:navigationBarColor">@color/aero_nav</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="nrAccent">@color/aero_blue</item>
        <item name="nrSecondary">@color/aero_green</item>
        <item name="nrText">@color/aero_ink</item>
        <item name="nrMuted">@color/aero_muted</item>
        <item name="nrDanger">@color/aero_danger</item>
        <item name="nrTopbar">@color/aero_pale</item>
        <item name="nrPrimaryButtonText">@color/aero_text_white</item>
        <item name="nrSecondaryButtonText">@color/aero_text_white</item>
        <item name="nrPanelBackground">@drawable/panel_aero</item>
        <item name="nrPrimaryButton">@drawable/btn_aero_blue</item>
        <item name="nrSecondaryButton">@drawable/btn_aero_green</item>
    </style>

    <style name="NrLabel">
        <item name="android:textColor">?attr/nrAccent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="NrButton" parent="android:Widget.Material.Button">
        <item name="android:background">?attr/nrPrimaryButton</item>
        <item name="android:textColor">?attr/nrPrimaryButtonText</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NrButton.Alt">
        <item name="android:background">?attr/nrSecondaryButton</item>
        <item name="android:textColor">?attr/nrSecondaryButtonText</item>
    </style>

    <!-- Compact version of NrButton for the slim driver bar. -->
    <style name="NrBarButton" parent="NrButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="NrBarButton.Alt" parent="NrButton.Alt">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

</resources>
