<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon to jump straight to the server settings. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_server"
        android:shortcutId="server_settings"
        android:shortcutLongLabel="@string/shortcut_server_long"
        android:shortcutShortLabel="@string/shortcut_server_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.nightrider.driver.SetupActivity"
            android:targetPackage="com.nightrider.driver" />
    </shortcut>
</shortcuts>
