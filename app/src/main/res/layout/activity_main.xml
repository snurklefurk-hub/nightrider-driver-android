<?xml version="1.0" encoding="utf-8"?>
<!--
  Driver console. Top bar carries only a small Settings button: the server is
  fixed in code, so there is no reload or server button. The sign-in card is
  replaced by the board once a driver is signed in.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/nrTopbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/settingsButton"
            style="@style/NrBarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/loginScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/loginPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/NrLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_heading"
                android:textColor="?attr/nrText"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_help"
                android:textColor="?attr/nrMuted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="?attr/nrAccent"
                android:hint="@string/hint_name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textColor="?attr/nrText"
                android:textColorHint="?attr/nrMuted" />

            <EditText
                android:id="@+id/passInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="?attr/nrAccent"
                android:hint="@string/hint_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="?attr/nrText"
                android:textColorHint="?attr/nrMuted" />

            <Button
                android:id="@+id/loginButton"
                style="@style/NrButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/login_button" />

            <TextView
                android:id="@+id/loginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/nrDanger"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/boardPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/driverLine"
            style="@style/NrLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/boardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/nrDanger"
            android:textSize="12sp" />

        <Button
            android:id="@+id/driverMapButton"
            style="@style/NrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open driver map" />

        <ScrollView
            android:id="@+id/boardScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/NrLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_open" />

                <LinearLayout
                    android:id="@+id/openRides"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    style="@style/NrLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/section_mine" />

                <LinearLayout
                    android:id="@+id/myRides"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <TextView
            style="@style/NrLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/section_chat" />

        <!-- Fixed-size recipient controls. Messages never insert or move buttons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button android:id="@+id/chatTabTeam" style="@style/NrBarButton"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:text="Team" android:textAllCaps="false" />
            <Button android:id="@+id/chatTabDispatch" style="@style/NrBarButton"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:text="Dispatch" android:textAllCaps="false" />
            <Button android:id="@+id/chatTabRider" style="@style/NrBarButton"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:text="Rider" android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="52dp" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/chatRecipientSummary"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center_vertical"
                android:text="To all drivers" android:textColor="?attr/nrMuted"
                android:textSize="12sp" />
            <Spinner android:id="@+id/chatRideSelector"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:contentDescription="Select ride conversation"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/chatLog"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="8dp"
            android:background="?attr/nrPanelBackground"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/chatContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/chatText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="?attr/nrAccent"
                android:hint="@string/chat_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="?attr/nrText"
                android:textColorHint="?attr/nrMuted" />

            <Button
                android:id="@+id/chatSend"
                style="@style/NrBarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
