<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#A9CAD9"/>
            <corners android:radius="26dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#A2DFF7" android:endColor="#095F9C"/>
            <stroke android:width="1dp" android:color="#0A649B"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#E3F9FF"
                android:centerColor="#34B4E9" android:endColor="#0876B8"/>
            <stroke android:width="1dp" android:color="#308AB6"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
</selector>
