<?xml version="1.0" encoding="utf-8"?>
<!-- Nightwave backdrop: deep indigo night sky with a soft cyan glow top-right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/void_night"
                android:centerColor="@color/indigo"
                android:endColor="#080611" />
        </shape>
    </item>
</layer-list>
