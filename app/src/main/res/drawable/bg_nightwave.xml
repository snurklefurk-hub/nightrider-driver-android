<?xml version="1.0" encoding="utf-8"?>
<!-- Tidal Emerald night backdrop with a soft emerald-cyan glow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#164343"
                android:centerColor="@color/indigo"
                android:endColor="@color/void_night" />
        </shape>
    </item>
    <item android:top="0dp" android:gravity="top|end" android:height="220dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="225"
                android:startColor="#332FE9FF"
                android:endColor="#002FE9FF" />
        </shape>
    </item>
</layer-list>
