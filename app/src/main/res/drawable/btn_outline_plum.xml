<?xml version="1.0" encoding="utf-8"?>
<!-- Plum outline button — used for the secondary action, like the site. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33C464B1" />
            <stroke android:width="1dp" android:color="@color/plum" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AC464B1" />
            <stroke android:width="1dp" android:color="#80C464B1" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
