<?xml version="1.0" encoding="utf-8"?>
<!-- Cyan outline button with a soft nightwave glow, matching the site buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3300F0FF" />
            <stroke android:width="1dp" android:color="@color/cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#141B2E" />
            <stroke android:width="1dp" android:color="#3A4666" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A00F0FF" />
            <stroke android:width="1dp" android:color="@color/line_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
