<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen outline button with a soft aquatic glow, matching the site buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#337FE6D2" />
            <stroke android:width="1dp" android:color="@color/cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#101F2B" />
            <stroke android:width="1dp" android:color="#2C4152" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A7FE6D2" />
            <stroke android:width="1dp" android:color="@color/line_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
