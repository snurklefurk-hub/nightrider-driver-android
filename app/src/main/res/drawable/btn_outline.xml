<?xml version="1.0" encoding="utf-8"?>
<!-- Emerald signal button matching Midnight Transit. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3319D47B" />
            <stroke android:width="1dp" android:color="@color/cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#26173A29" />
            <stroke android:width="1dp" android:color="#66416B52" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A19D47B" />
            <stroke android:width="1dp" android:color="@color/line_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
