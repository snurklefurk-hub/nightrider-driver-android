<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen outline button with a soft aquatic glow, matching the site buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#332FE9FF" />
            <stroke android:width="1dp" android:color="@color/cyan" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1010271B" />
            <stroke android:width="1dp" android:color="#31533E" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#140B1D13" />
            <stroke android:width="1dp" android:color="@color/line_cyan" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
